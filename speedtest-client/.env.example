# PigeonRelay 地址 (必填)
PIGEONRELAY_URL=http://1.2.3.4:3214

# 延迟上报 Token，与 Settings 页面一致 (必填)
LATENCY_TOKEN=your-latency-token

# 运营商标识 (用于自定义算法筛选)
CLIENT_ISP=移动
CLIENT_REGION=华南

# ===== 并发控制 =====
TCP_WORKERS=50         # Phase 1 TCP 并发
TLS_WORKERS=10          # Phase 2 TLS 并发
TCP_TIMEOUT=2           # TCP 拨号超时 (秒)
TCP_TRIES=3             # 每 IP 测量次数
TCP_TOP_N=200           # Phase 1 → Phase 2 数量
TLS_TIMEOUT=3           # TLS 握手超时 (秒)
TLS_TOP_M=50            # Phase 2 → Phase 3 数量
FAST_INTERVAL=120       # Phase 3 精确复测间隔 (秒)
FAST_TRIES=1
FAST_TIMEOUT=1.5
FAST_WORKERS=10

# ===== 分片与间隔 =====
PHASE1_SHARDS=4         # Phase 1 分片数
SHARD_INTERVAL=45       # 分片间隔 (秒)
MEASURE_INTERVAL=600    # Phase 1 全量扫描间隔 (秒)
REPORT_INTERVAL=1200    # 上报间隔 (秒)

# ===== 过滤与保护 =====
TLL_MIN_MS=0            # 电信/联通建议 40, 移动/海外 0
MIN_VALID_MS=15         # 有效延迟下限 (ms)
TEST_PORT=443           # 测试端口
TEST_SNI=               # TLS SNI (空则用 IP)
OOM_MAX_SEC=7200        # 数据保留时间
MAX_IPS_PER_REPORT=400  # 单次上报上限

# ===== 基础 =====
PYTHONUNBUFFERED=1      # Docker 日志实时输出
DATA_DIR=data           # 数据目录
